# ==============================================================================
# My CRM Salon SaaS — Environment Variables Template
# ==============================================================================
# WARNING: NEVER commit real database URLs or secret keys into Git.
#
# 1. Database Connections (Independent My CRM Salon Neon Database ONLY)
# Never use Somoud Recruitment CRM database credentials here.
#
# SALON_MIGRATION_DATABASE_URL:
# اتصال إداري مرخص حصرياً لمدير النظام لتطبيق ترقيات المخطط (DDL migrations)
SALON_MIGRATION_DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# SALON_DATABASE_URL:
# اتصال التطبيق العادي بدور مقيد (salon_app_role) مفروض عليه RLS إجبارياً
SALON_DATABASE_URL=postgresql://salon_app_role:role_password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# SALON_TEST_DATABASE_URL:
# قاعدة اختبارات مؤقتة معزولة محلية فقط (يمنع استخدام أي قاعدة سحابية للاختبار)
SALON_TEST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:54338/postgres

# 2. Session & Cryptography Secret
# Minimum 32 random characters used for HMAC-SHA256 session token signatures
SALON_SESSION_SECRET=your_minimum_32_characters_random_hex_secret_here

# 3. Environment & Export Mode
NODE_ENV=development
NEXT_OUTPUT_EXPORT=false

