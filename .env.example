# ==============================================================================
# My CRM Salon SaaS — Environment Variables Template
# ==============================================================================
# WARNING: NEVER commit real database URLs or secret keys into Git.
#
# 1. Database Connections (Independent My CRM Salon Neon Database ONLY)
# Never use Somoud Recruitment CRM database credentials here.
SALON_DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/mycrmsalon?sslmode=require
SALON_TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/mycrmsalon_test

# 2. Session & Cryptography Secret
# Minimum 32 random characters used for HMAC-SHA256 session token signatures
SALON_SESSION_SECRET=your_minimum_32_characters_random_hex_secret_here

# 3. Environment & Export Mode
NODE_ENV=development
NEXT_OUTPUT_EXPORT=false
