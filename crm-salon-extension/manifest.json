{
  "manifest_version": 3,
  "name": "My CRM Salon - التقاط العميلات وتنسيق المواعيد",
  "version": "1.0.0",
  "version_name": "1.0.0-production",
  "description": "إضافة التقاط بيانات العميلات والخدمات المطلوبة من واتساب ويب ومزامنتها مباشرة مع صالونك في My CRM Salon",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://crmsalon.de/*",
    "https://*.crmsalon.de/*",
    "https://*.trycloudflare.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "تسجيل عميلة في My CRM Salon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
